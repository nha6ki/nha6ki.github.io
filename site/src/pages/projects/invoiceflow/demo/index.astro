---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---
<BaseLayout title="InvoiceFlow review workbench | Haruki Niwa"
  description="Run InvoiceFlow's actual reconciliation rules on editable sample invoices in your browser.">
  <main class="workbench">
    <a href="/projects/invoiceflow/">← InvoiceFlow project</a>
    <header>
      <h1>Invoice review workbench</h1>
      <p>Edit an invoice, add a receipt, and see whether the actual InvoiceFlow rules allow approval. Data and the review database stay in this browser session. Input is structured JSON, already extracted from an invoice in a typical workflow.</p>
    </header>
    <invoice-workbench>
      <div class="controls" role="group" aria-label="Load a sample">
        <button type="button" data-sample="quantity">Partial delivery</button>
        <button type="button" data-sample="amount">Incorrect line amount</button>
      </div>
      <div class="workspace">
        <section aria-labelledby="input-heading">
          <h2 id="input-heading">Review inputs</h2>
          <details>
            <summary>Purchase order, initial receipts and prior approvals</summary>
            <label for="setup">Setup JSON</label>
            <textarea id="setup" rows="11" spellcheck="false"></textarea>
            <p class="hint">Start a new review to apply setup edits. This clears the current session's approval and receipt history.</p>
          </details>
          <label for="invoice">Invoice JSON</label>
          <textarea id="invoice" rows="14" spellcheck="false"></textarea>
          <div class="controls">
            <button type="button" data-action="start">Start new review</button>
            <button type="button" data-action="check" disabled>Recheck invoice</button>
          </div>
          <details data-receipt-panel>
            <summary>Add a receipt</summary>
            <label for="receipt">Receipt JSON</label>
            <textarea id="receipt" rows="8" spellcheck="false"></textarea>
            <button type="button" data-action="receipt" disabled>Record receipt and recheck</button>
          </details>
        </section>
        <section aria-labelledby="result-heading">
          <h2 id="result-heading">Review result</h2>
          <p data-status role="status" class="status">Start a review to load the browser engine.</p>
          <p data-error role="alert" hidden></p>
          <ul data-issues hidden></ul>
          <div data-evidence class="scroll" hidden></div>
          <label for="note">Approval reason</label>
          <input id="note" placeholder="What did you verify?" maxlength="300" />
          <div class="controls">
            <button type="button" data-action="approve" disabled>Approve invoice</button>
            <button type="button" data-download disabled>Download review JSON</button>
          </div>
          <details data-audit-panel hidden>
            <summary>Review history</summary>
            <pre data-audit></pre>
          </details>
        </section>
      </div>
    </invoice-workbench>
    <noscript><p>Enable JavaScript to run the workbench.</p></noscript>
  </main>
</BaseLayout>

<script>
  import engine from './review_flow.py?raw';
  import reconciliation from './three_way.py?raw';
  import adapter from './workbench.py?raw';

  const CDN = 'https://cdn.jsdelivr.net/pyodide/v314.0.8/full/';
  type Runtime = {
    FS: { writeFile: (name: string, source: string) => void };
    runPython: (source: string) => unknown;
    globals: { get: (name: string) => unknown };
  };
  type Issue = { field: string; reason: string; expected?: string; actual?: string | null; difference?: string };
  type Evidence = {
    item: string; ordered: string; received: string; approved: string; requested: string;
    available: string; excess: string; receipt_ids: string[]; prior_invoices: string[];
  };
  type Result = {
    status: 'needs_review' | 'ready_for_approval' | 'registered'; issues: Issue[];
    reconciliation: Evidence[]; events: unknown[];
    receipt: { receipt_id: string; reused: boolean } | null; error?: string;
  };
  let runtime: Promise<(action: string, payload: string) => string> | undefined;
  function loadEngine() {
    runtime ??= (async () => {
      const url = CDN + 'pyodide.mjs';
      const { loadPyodide } = await import(/* @vite-ignore */ url);
      const py: Runtime = await loadPyodide({ indexURL: CDN });
      py.FS.writeFile('review_flow.py', engine);
      py.FS.writeFile('three_way.py', reconciliation);
      py.runPython(adapter);
      return py.globals.get('run_action') as (action: string, payload: string) => string;
    })().catch(error => {
      runtime = undefined;
      throw error;
    });
    return runtime;
  }

  function sample(kind: string) {
    const line = (quantity: string, unit_price: string, line_total: string) =>
      ({ item: 'WIDGET-A', quantity, unit_price, line_total });
    const identity = { supplier: 'Demo Supplier', currency: 'EUR', po_number: 'DEMO-PO-100' };
    const invoice = (id: string, quantity: string, price: string, net: string, gross: string) => ({
      ...identity, invoice_number: id, issue_date: '2025-07-02', gross_total: gross,
      lines: [{ line_id: '1', ...line(quantity, price, net) }],
    });
    const receipt = (id: string, quantity: string) => ({
      receipt_id: id, lines: [{ item: 'WIDGET-A', quantity }],
    });
    if (kind === 'amount') {
      return {
        setup: {
          order: { ...identity, matching: 'three_way', lines: [line('200', '40', '8000')] },
          receipts: [receipt('RCPT-001', '200')], prior_invoices: [],
        },
        invoice: invoice('DEMO-AMT-001', '200', '40', '9600', '9600'),
        receipt: receipt('RCPT-002', '10'),
      };
    }
    return {
      setup: {
        order: { ...identity, matching: 'three_way', lines: [line('100', '10', '1000')] },
        receipts: [receipt('RCPT-001', '60')], prior_invoices: [invoice('DEMO-INV-001', '40', '10', '400', '400')],
      },
      invoice: invoice('DEMO-INV-002', '30', '10', '300', '300'),
      receipt: receipt('RCPT-002', '10'),
    };
  }

  class Workbench extends HTMLElement {
    connectedCallback() {
      const el = <T extends HTMLElement>(selector: string) => this.querySelector<T>(selector)!;
      const setup = el<HTMLTextAreaElement>('#setup');
      const invoice = el<HTMLTextAreaElement>('#invoice');
      const receipt = el<HTMLTextAreaElement>('#receipt');
      const note = el<HTMLInputElement>('#note');
      const status = el('[data-status]');
      const error = el('[data-error]');
      const issues = el('[data-issues]');
      const evidence = el('[data-evidence]');
      const audit = el('[data-audit]');
      const download = el<HTMLButtonElement>('[data-download]');
      const controls = [...this.querySelectorAll<HTMLButtonElement>('button:not([data-download])')];
      const pretty = (value: unknown) => JSON.stringify(value, null, 2);
      let result: Result | undefined;
      let dirty = false;
      let busy = false;

      const sync = () => {
        const registered = result?.status === 'registered';
        controls.forEach(button => {
          const action = button.dataset.action;
          button.disabled = busy || (action === 'approve'
            ? dirty || result?.status !== 'ready_for_approval' || !note.value.trim()
            : (action === 'check' || action === 'receipt') && (!result || registered));
        });
        setup.disabled = receipt.disabled = busy;
        invoice.disabled = note.disabled = busy || registered;
        download.disabled = busy || !result || dirty;
      };
      const show = (next: Result) => {
        let message = {
          needs_review: 'On hold — resolve the issues before approval.',
          ready_for_approval: 'Ready for approval — record your reason to continue.',
          registered: 'Approved — the review event is recorded in this session.',
        }[next.status];
        if (next.receipt?.reused) message += ' Receipt already recorded; no quantities were added.';
        status.textContent = message;
        status.dataset.tone = next.status;
        issues.replaceChildren(...next.issues.map(issue => {
          const row = document.createElement('li');
          const values = issue.expected !== undefined
            ? ` · expected ${issue.expected}, entered ${issue.actual ?? 'missing'}${issue.difference ? `, difference ${issue.difference}` : ''}`
            : '';
          row.textContent = `${issue.field} — ${issue.reason.replaceAll('_', ' ')}${values}`;
          return row;
        }));
        issues.hidden = !next.issues.length;

        const table = document.createElement('table');
        const head = table.createTHead().insertRow();
        for (const label of ['Item', 'Ordered', 'Received', 'Prior approvals', 'Requested', 'Available', 'Excess', 'Receipts / prior invoices']) {
          const cell = document.createElement('th');
          cell.scope = 'col';
          cell.textContent = label;
          head.append(cell);
        }
        const body = table.createTBody();
        for (const row of next.reconciliation) {
          const values = [row.item, row.ordered, row.received, row.approved, row.requested,
            row.available, row.excess, [...row.receipt_ids, ...row.prior_invoices].join(', ')];
          const tr = body.insertRow();
          values.forEach(value => { tr.insertCell().textContent = value; });
        }
        evidence.replaceChildren(table);
        evidence.hidden = !next.reconciliation.length;
        audit.textContent = pretty(next.events);
        el('[data-audit-panel]').hidden = !next.events.length;
      };
      const run = async (action: string) => {
        if (busy) return;
        busy = true;
        sync();
        try {
          error.hidden = true;
          const payload: Record<string, unknown> = { invoice: JSON.parse(invoice.value) };
          if (action === 'start') payload.setup = JSON.parse(setup.value);
          if (action === 'receipt') payload.receipt = JSON.parse(receipt.value);
          if (action === 'approve') payload.note = note.value;
          if (!runtime) status.textContent = 'Loading the Python review engine…';
          const execute = await loadEngine();
          const next = JSON.parse(execute(action, JSON.stringify(payload))) as Result;
          if (next.error !== undefined) throw Error(next.error);
          result = next;
          dirty = false;
          show(result);
        } catch (exc) {
          error.textContent = exc instanceof Error ? exc.message : String(exc);
          error.hidden = false;
          status.textContent = 'Action could not be completed. Check the input and try again.';
        } finally {
          busy = false;
          sync();
        }
      };
      const useSample = (kind: string) => {
        const values = sample(kind);
        setup.value = pretty(values.setup);
        invoice.value = pretty(values.invoice);
        receipt.value = pretty(values.receipt);
        note.value = '';
        dirty = true;
        result = undefined;
        issues.hidden = evidence.hidden = el('[data-audit-panel]').hidden = true;
        void run('start');
      };
      controls.forEach(button => button.addEventListener('click', () => {
        if (button.dataset.sample) useSample(button.dataset.sample);
        else if (button.dataset.action) void run(button.dataset.action);
      }));
      invoice.addEventListener('input', () => {
        dirty = true;
        status.textContent = 'Invoice edited — recheck to update the decision.';
        sync();
      });
      note.addEventListener('input', sync);
      download.addEventListener('click', () => {
        const href = URL.createObjectURL(new Blob([pretty(result)], { type: 'application/json' }));
        const link = document.createElement('a');
        link.href = href;
        link.download = 'invoiceflow-review.json';
        link.click();
        setTimeout(() => URL.revokeObjectURL(href), 1000);
      });
      useSample('quantity');
    }
  }
  customElements.define('invoice-workbench', Workbench);
</script>

<style>
  .workbench { max-width: 72rem; margin-inline: auto; padding: clamp(1rem, 4vw, 3rem); }
  header { max-width: 49rem; margin-block: 2rem 1.5rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; }
  .workspace { display: grid; grid-template-columns: 1fr 1.25fr; gap: 1rem; margin-block: 1rem; }
  section { border: 1px solid currentColor; padding: 1rem; border-radius: .65rem; min-width: 0; }
  h2 { font-size: 1.18rem; margin: 0 0 1rem; }
  label { display: block; font-weight: 650; margin-block: .8rem .25rem; }
  input, textarea { width: 100%; background: transparent; color: inherit; border: 1px solid currentColor; border-radius: .4rem; padding: .6rem; }
  textarea, pre { font: .81rem/1.55 ui-monospace, monospace; overflow: auto; }
  textarea { resize: vertical; }
  button { font: inherit; padding: .55rem .75rem; background: transparent; color: inherit; border: 1px solid currentColor; border-radius: .4rem; cursor: pointer; }
  button:disabled { opacity: .5; cursor: default; }
  button[data-action="approve"]:enabled { background: #14685a; color: #fff; }
  .controls { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: .65rem; }
  .status { padding: .65rem; border-radius: .4rem; background: #e1f4ee; color: #153a35; }
  .status[data-tone="needs_review"] { background: #ffebcb; color: #5a3600; }
  [data-error] { padding: .45rem; color: #6a2500; background: #ffebcb; }
  .hint { font-size: .85rem; }
  .scroll { overflow-x: auto; }
  details { margin-block: .65rem; }
  summary { cursor: pointer; }
  pre { max-height: 22rem; }
  @media (max-width: 760px) { .workspace { grid-template-columns: 1fr; } }
</style>
