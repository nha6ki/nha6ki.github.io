---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort(
    (a, b) =>
      (b.data.date ?? '').localeCompare(a.data.date ?? '') ||
      a.data.order - b.data.order
  );
---

<BaseLayout
  title="Projects | Haruki Niwa"
  description="Explore research and software development projects by Haruki Niwa, including machine learning applications, recommendation systems, and scientific computing."
>
  <div class="content-page" style="padding-bottom: 10px;">
    <h1>Projects</h1>

    <p class="lead">
        A selection of my research and development projects.
      </p>
  </div>

  <div class="project-grid projects-page-grid">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</BaseLayout>


<style is:global>
  /* PROJECTS_THREE_COLUMN_LAYOUT */
  .project-grid.projects-page-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 850px) {
    .project-grid.projects-page-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .project-grid.projects-page-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
