---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { siGithub } from 'simple-icons';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as {
  project: CollectionEntry<'projects'>;
};

const { Content } = await render(project);
const isWebRegression = project.id === 'web-regression';
const demoLink = isWebRegression ? project.data.links.find((link) => link.label === 'View demo') : undefined;

// This project introduces its two systems before showing their cover illustration.
const hasInlineIntroduction = project.id === 'lab-document-rag';

const formattedDate = project.data.date
  ? new Intl.DateTimeFormat('en-US', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(`${project.data.date}-01T00:00:00Z`))
  : null;

function linkInfo(url: string) {
  const parsedUrl = new URL(url);
  const hostname = parsedUrl.hostname.toLowerCase();

  if (hostname === 'github.com' &&
      parsedUrl.pathname.includes('/blob/')) {
    return { github: true, detail: 'GitHub File' };
  }

  if (hostname === 'github.com' ||
      hostname.endsWith('.github.com')) {
    return { github: true, detail: 'GitHub Repository' };
  }

  if (hostname.endsWith('.github.io')) {
    return { github: true, detail: 'GitHub Pages' };
  }

  return { github: false, detail: hostname };
}

const resourceLinks = project.data.links.filter((link) => link !== demoLink).map((link) => ({
  ...link,
  info: linkInfo(link.url),
}));
---

<BaseLayout
  title={`${project.data.title} | Haruki Niwa`}
  description={project.data.summary}
>
  <article class="content-page" data-project={project.id}>
    <a class="text-link" href="/projects/">
      ← All Projects
    </a>

    <h1>{project.data.title}</h1>
    {project.id === 'company-disclosure-monitor' && (
      <a class="text-link" href="/projects/company-disclosure-monitor/ja/" lang="ja" hreflang="ja">日本語で読む</a>
    )}

    {!hasInlineIntroduction && <p class="lead">{project.data.summary}</p>}

    {formattedDate && (
      <time class="project-date" datetime={project.data.date}>
        {formattedDate}
      </time>
    )}

    {demoLink && (
      <nav class="web-regression-actions" aria-label="Project resources">
        <a class="web-regression-demo" href={demoLink.url}>{demoLink.label}</a>
        {resourceLinks.map((link) => <a href={link.url}>{link.label}</a>)}
      </nav>
    )}

    {!isWebRegression && resourceLinks.length > 0 && (
      <nav
        class="project-resources"
        aria-label="Project resources"
      >
        {resourceLinks.map((link) => (
          <a
            class="project-resource"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">
              {link.info.github ? (
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={siGithub.path} />
                </svg>
              ) : (
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18" />
                  <path d="M12 3a15 15 0 0 1 0 18" />
                  <path d="M12 3a15 15 0 0 0 0 18" />
                </svg>
              )}
            </span>

            <span class="resource-text">
              <span class="resource-title">
                {link.label}
              </span>
              <span class="resource-detail">
                {link.info.detail}
              </span>
            </span>

            <span class="resource-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </nav>
    )}

    {!hasInlineIntroduction && project.data.image && (
      <a
        class:list={["project-cover-link", { "project-cover-wide": isWebRegression }]}
        href={project.data.image}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View full-size image of ${project.data.title}`}
      >
        <img
          class="project-cover"
          src={project.data.image}
          alt={project.data.imageAlt ?? `Screenshot of ${project.data.title}`}
          loading="lazy"
          decoding="async"
        />
      </a>
    )}

    {isWebRegression && (
      <section class="regression-example" aria-labelledby="regression-example-title">
        <h2 id="regression-example-title">A declined Shopify payment, retried successfully</h2>
        <ol>
          <li>Shopify displayed a payment error on the first attempt.</li>
          <li>The buyer retried in the same checkout. The total was $38.00.</li>
          <li>The store recorded a paid test order for two red notebooks and one blue notebook, totaling $38.00.</li>
        </ol>
        <a href="/demos/web-regression/en/SH-12.html">See the SH-16 evidence</a>
      </section>
    )}

    <div class="project-body">
      <Content />
    </div>

    <section>
      <h2>Tools & Technologies</h2>
      <p class="technologies">
        {project.data.technologies.join(' · ')}
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .web-regression-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin: 24px 0;
  }

  .web-regression-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .web-regression-actions .web-regression-demo {
    border-radius: 7px;
    padding: 0 17px;
    background: #075e59;
    color: #fff;
    font-weight: 650;
    text-decoration: none;
  }

  .web-regression-actions .web-regression-demo:hover,
  .web-regression-actions .web-regression-demo:focus-visible {
    background: #124943;
    color: #fff;
    text-decoration: underline;
  }

  .regression-example {
    background: #f2f7f5;
    border: 1px solid #d1ddd6;
    border-radius: 10px;
    padding: clamp(16px, 3vw, 24px);
    margin: 0 0 28px;
  }

  .regression-example h2 { margin-top: 0; }
  .regression-example ol { padding-inline-start: 1.4em; }
  .regression-example li + li { margin-top: .3em; }
  .regression-example a { display: inline-flex; align-items: center; min-height: 44px; }

  .project-date {
    display: block;
    margin: 12px 0 24px;
    color: #64748b;
    font-size: .9rem;
  }

  .project-resources {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 26px 0 32px;
  }

  .project-resource {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 17px;
    border: 1px solid #e2e6eb;
    border-radius: 10px;
    background: #fff;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .project-resource:hover {
    border-color: #a7b8cf;
    background: #f8fafc;
  }

  .resource-icon {
    display: flex;
    flex: none;
    color: #334155;
  }

  .resource-icon svg {
    width: 23px;
    height: 23px;
    fill: currentColor;
  }

  .resource-icon svg[fill="none"] {
    fill: none;
  }

  .resource-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    gap: 3px;
  }

  .resource-title {
    font-size: .9rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .resource-detail {
    font-size: .77rem;
    color: #64748b;
  }

  .resource-arrow {
    flex: none;
    align-self: flex-start;
    color: #64748b;
    font-size: .9rem;
  }

  .project-cover-link {
    display: block;
    width: min(100%, 520px);
    margin: 30px auto 16px;
    border-radius: 10px;
  }

  .project-cover-wide { width: 100%; }

  .project-cover {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 1px solid #e2e6eb;
    border-radius: 10px;
  }

  .project-cover-link:hover .project-cover {
    border-color: #94a3b8;
  }

  @media (max-width: 640px) {
    .project-resources {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-resource {
      transition: none;
    }
  }
</style>
