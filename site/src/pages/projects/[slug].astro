---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as {
  project: CollectionEntry<'projects'>;
};

const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} | Haruki Niwa`}
  description={project.data.summary}
>
  <article class="content-page">
    <a class="text-link" href="/projects/">
      ← All Projects
    </a>

    <h1>{project.data.title}</h1>
    <p class="lead">{project.data.summary}</p>

    {project.data.image && (
      <a
        class="project-cover-link"
        href={project.data.image}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View full-size screenshot of ${project.data.title}`}
      >
        <img
          class="project-cover"
          src={project.data.image}
          alt={`Screenshot of ${project.data.title}`}
          loading="lazy"
          decoding="async"
        />
      </a>
    )}

    {project.data.links.length > 0 && (
      <nav class="project-links" aria-label="Project links">
        {project.data.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label} ↗
          </a>
        ))}
      </nav>
    )}

    <div class="project-body">
      <Content />
    </div>

    <section>
      <h2>Technologies</h2>
      <p class="technologies">
        {project.data.technologies.join(' · ')}
      </p>
    </section>
  </article>
</BaseLayout>
