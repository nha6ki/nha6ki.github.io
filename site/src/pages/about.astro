---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { socials, linkedinIcon } from '../data/socials';
import * as icons from 'simple-icons';

const experiences = [
  {
    period: 'Apr 2025 – Present',
    role: 'Education and Research Support Staff',
    organization: 'BMK Center, Hiroshima University',
    url: 'https://zoelabo.com/',
  },
  {
    period: 'Mar 2022 – Mar 2025',
    role: 'Researcher',
    organization: 'Araya Inc.',
    url: 'https://www.araya.org/en/',
  },
  {
    period: 'Apr 2021 – Mar 2022',
    role: 'Research Intern',
    organization: 'Araya Inc.',
    url: 'https://www.araya.org/en/',
  },
  {
    period: 'Jun 2017 – Mar 2021',
    role: 'Part-time Technical Support Staff',
    organization: 'National Institute for Physiological Sciences',
    url: 'https://www.nips.ac.jp/eng/',
  },
];

const iconFor = (key: string) =>
  (icons as unknown as Record<string, { svg: string } | undefined>)[key] ?? null;

const skillGroups = [
  {
    category: 'Machine Learning & Data Science',
    items: [
      { name: 'Python', icon: iconFor('siPython') },
      { name: 'PyTorch', icon: iconFor('siPytorch') },
      { name: 'TensorFlow', icon: iconFor('siTensorflow') },
      { name: 'scikit-learn', icon: iconFor('siScikitlearn') },
      { name: 'NumPy', icon: iconFor('siNumpy') },
      { name: 'SciPy', icon: iconFor('siScipy') },
      { name: 'pandas', icon: iconFor('siPandas') },
    ],
  },
  {
    category: 'Neuroimaging & Robotics',
    items: [
      { name: 'EEG', icon: null },
      { name: 'fMRI', icon: null },
      { name: 'FSL', icon: null },
      { name: 'ANTs', icon: null },
      { name: 'ROS', icon: iconFor('siRos') },
    ],
  },
  {
    category: 'Infrastructure & Cloud',
    items: [
      { name: 'Linux', icon: iconFor('siLinux') },
      { name: 'Docker', icon: iconFor('siDocker') },
      { name: 'HTCondor', icon: null },
      { name: 'Prometheus', icon: iconFor('siPrometheus') },
      { name: 'Grafana', icon: iconFor('siGrafana') },
      { name: 'Google Cloud Run', icon: iconFor('siGooglecloud') },
    ],
  },
  {
    category: 'Web & Software Development',
    items: [
      { name: 'FastAPI', icon: iconFor('siFastapi') },
      { name: 'JavaScript', icon: iconFor('siJavascript') },
      { name: 'Astro', icon: iconFor('siAstro') },
      { name: 'Scrapy', icon: iconFor('siScrapy') },
    ],
  },
];

const certifications = [
  {
    name: 'Pet Care Adviser — Level 2',
    organization: 'Japan Pet Care Association',
    issued: 'Jan 2025',
    url: 'https://www.jpc.or.jp/kanrishi/',
  },
  {
    name: 'Neko Kentei (Cat Knowledge Examination) — Intermediate Level',
    organization: 'Neko Kentei Organizing Committee',
    issued: 'May 2025',
    url: 'https://www.kentei-uketsuke.com/neko/',
  },
];

const interests = [
  {
    name: 'Books',
    links: [
      {
        name: 'Booklog',
        url: 'https://booklog.jp/users/nha6ki/all?category_id=all&status=all&rank=5',
      },
    ],
  },
  {
    name: 'Movies',
    links: [
      { name: 'Letterboxd', url: 'https://letterboxd.com/nha6ki/' },
    ],
  },
  {
    name: 'Music',
    links: [
      {
        name: 'Spotify',
        url: 'https://open.spotify.com/user/31v3cahrob7oechwpa6bqhuwh47i',
      },
    ],
  },
  {
    name: 'Painting',
    links: [
      {
        name: 'Tsukioka Yoshitoshi',
        url: 'https://artsandculture.google.com/entity/yoshitoshi/m01rtn7',
      },
      {
        name: 'Francis Bacon',
        url: 'https://www.wikiart.org/en/francis-bacon',
      },
      {
        name: 'Vincent van Gogh',
        url: 'https://www.wikiart.org/en/vincent-van-gogh',
      },
      {
        name: 'Nakamura Masayoshi',
        url: 'http://nakamuramasayoshi.com/',
      },
    ],
  },
  {
    name: 'Games',
    links: [
      {
        name: 'Backloggd',
        url: 'https://backloggd.com/u/nha6ki/likes/',
      },
    ],
  },
];

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://nha6ki.github.io/about/#profile',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://nha6ki.github.io/about/#person',
    name: 'Haruki Niwa',
    alternateName: ['丹羽開紀', '丹羽 開紀'],
    url: 'https://nha6ki.github.io/',
    sameAs: socials
      .filter((social) =>
        ['GitHub', 'LinkedIn', 'DEV.to', 'Twitter'].includes(social.name)
      )
      .map((social) => social.url),
  },
};
---

<BaseLayout
  title="About | Haruki Niwa (丹羽開紀)"
  description="Learn about Haruki Niwa (丹羽開紀), his professional experience, and technical skills in machine learning, neuroscience, and software engineering."
  structuredData={profileSchema}
>
  <div class="content-page about-page">
    <h1>About Me</h1>
    <p class="about-person-name">Haruki Niwa <span class="name-ja-group"><span class="name-divider" aria-hidden="true">/</span> <span lang="ja">丹羽開紀</span></span></p>

    <p class="lead">
      My background is in information science, with experience spanning
      machine learning, neuroscience research, and software engineering.
    </p>

    <p class="about-intro">
      I have worked in research and technical roles at the National
      Institute for Physiological Sciences, Araya, and Hiroshima University.
      My work has involved developing machine learning models, processing
      neuroscience data, building research software, and managing
      computing infrastructure.
    </p>

    <section>
      <h2>Experience</h2>

      <div class="experience-list">
        {experiences.map((item) => (
          <div class="experience-item">
            <div class="experience-period">{item.period}</div>
            <div class="experience-content">
              <h3>{item.role}</h3>
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.organization}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Education</h2>

      <div class="education-item">
        <strong>Aichi Prefectural University</strong>
        <p>Graduate School of Information Science and Technology · 2020–2022</p>
        <p>Undergraduate School of Information Science and Technology · 2016–2020</p>
      </div>
    </section>

    <section>
      <h2>Skills</h2>

      <div class="skill-groups">
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.category}</h3>

            <div class="skill-items">
              {group.items.map((skill) => (
                <span class="skill-item">
                  {skill.icon && <BrandIcon icon={skill.icon} />}
                  <span>{skill.name}</span>
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Certifications</h2>

      <div class="certification-list">
        {certifications.map((item) => (
          <div class="certification-item">
            <h3>{item.name}</h3>
            <p>{item.organization} · {item.issued}</p>
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              Certification Details
            </a>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Interests</h2>

      <ul class="interests-list">
        {interests.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <div class="interest-links">
              {item.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.name}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Find Me Online</h2>

      <div class="social-grid">
        {socials.map((item) => (
          <a
            class="social-chip"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.name === 'LinkedIn' ? (
              <svg
                class="brand-icon linkedin-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox={linkedinIcon.viewBox}
                aria-hidden="true"
                focusable="false"
              >
                <path d={linkedinIcon.path} />
              </svg>
            ) : item.icon ? (
              <BrandIcon icon={item.icon} />
            ) : null}
            <span>{item.name}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-person-name {
    margin: 10px 0 16px;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .name-ja-group {
    display: inline-block;
    white-space: nowrap;
  }

  .name-divider {
    color: #94a3b8;
    font-weight: 400;
  }

  .about-intro {
    color: #526070;
    font-size: 1rem;
    line-height: 1.75;
    margin-top: 14px;
  }

  .experience-list {
    display: grid;
    gap: 24px;
  }

  .experience-item {
    display: grid;
    grid-template-columns: 175px minmax(0, 1fr);
    gap: 18px;
  }

  .experience-period {
    color: #64748b;
    font-size: .85rem;
    padding-top: 3px;
  }

  .experience-content h3 {
    font-size: 1rem;
    font-weight: 650;
    margin: 0 0 5px;
  }

  .experience-content a,
  .interest-links a {
    color: #526070;
    transition: color 160ms ease;
  }

  .experience-content a:hover,
  .interest-links a:hover {
    color: #1d4ed8;
  }

  .education-item p {
    margin: 7px 0;
    color: #526070;
    font-size: .94rem;
  }

  .certification-list {
    display: grid;
    gap: 22px;
  }

  .certification-item h3 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 650;
  }

  .certification-item p {
    margin: 0;
    color: #64748b;
    font-size: .9rem;
  }

  .certification-item a {
    display: inline-block;
    margin-top: 3px;
    color: #526070;
    font-size: .88rem;
    text-decoration: underline;
    text-decoration-color: #cbd5e1;
    text-underline-offset: 3px;
  }

  .certification-item a:hover {
    color: #1d4ed8;
  }

  .interests-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .interests-list li {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid #e8ebef;
  }

  .interest-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 15px;
    overflow-wrap: anywhere;
  }

  .brand-icon {
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .experience-item {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .interests-list li {
      grid-template-columns: 1fr;
      gap: 5px;
    }
  }

  .skill-groups {
    display: grid;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 175px minmax(0, 1fr);
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid #e8ebef;
  }

  .skill-group h3 {
    margin: 7px 0 0;
    font-size: .94rem;
    font-weight: 600;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 11px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    font-size: .86rem;
  }

  .skill-item :global(.brand-icon) {
    width: 18px;
    height: 18px;
  }

  .linkedin-icon {
    fill: currentColor;
  }

  .experience-content a,
  .interest-links a {
    text-decoration: underline;
    text-decoration-color: #cbd5e1;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .skill-group {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

</style>
