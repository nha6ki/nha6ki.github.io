---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSocialLinks from '../components/HomeSocialLinks.astro';
import DevArticles from '../components/DevArticles.astro';
import { getCollection } from 'astro:content';

const projects = new Map((await getCollection('projects', ({ data }) => data.featured))
  .map(project => [project.id, project]));

const groups = [
  { title: 'Art', ids: ['art-museum-recommender', 'scene-to-art'] },
  { title: 'Cats', ids: ['meowatlas', 'felisfield', 'cat-behavior-collar-signals'] },
  { title: 'Music', ids: ['lyrimelotrace', 'notable-musical-patterns'] },
  { title: 'Literature', ids: ['storychroma'] },
  { title: 'Economy & Finance', ids: ['company-disclosure-monitor', 'economy-watchers-evidence-explorer', 'japan-fiscal-atlas'] },
  { title: 'Research Computing', ids: ['lab-document-rag', 'htcondor-gpu-pool'] },
].map(({ title, ids }) => ({
  title,
  cards: ids.map(id => {
    const project = projects.get(id);
    if (!project) throw new Error(`Missing featured project: ${id}`);
    return project;
  }),
}));
---

<BaseLayout
  title="Haruki Niwa (丹羽開紀) | Research & Engineering"
  description="Haruki Niwa (丹羽開紀) works on neuroscience data analysis, machine learning, research software, and computing infrastructure at Hiroshima University, and builds interactive web applications as a hobby."
>
  <section class="hero">
    <h1>Haruki Niwa</h1>

    <p class="lead">
      At Hiroshima University, I work on neuroscience data analysis,
      machine learning models, research software, and computing infrastructure.
    </p>

    <p class="lead">
      Outside of work, I build interactive web applications as a hobby,
      exploring sound, music, and text through listening and visualization.
    </p>

    <HomeSocialLinks />
  </section>

  <section class="section" aria-labelledby="articles-heading">
    <div class="section-heading">
      <h2 id="articles-heading">Latest Articles</h2>
      <a class="text-link" href="/blog/">View all →</a>
    </div>

    <div class="home-articles">
      <DevArticles limit={6} />
    </div>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <h2 id="projects-heading">Selected Projects</h2>
      <a class="text-link" href="/projects/">View all →</a>
    </div>

    {groups.map(({ title, cards }) => (
      <section class="project-group">
        <h3>{title}</h3>
        <ul class="project-row">
          {cards.map(({ id, data }) => (
            <li>
              <a class="project-preview" href={`/projects/${id}/`}>
                {data.image && <img class:list={{ 'cover-top': id === 'japan-fiscal-atlas' }} src={data.image} alt="" loading="lazy" />}
                <span class="preview-copy">
                  <strong>{data.title}</strong>
                  <span class="summary">{data.summary}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .hero h1 { margin-bottom: 6px; }

  .project-group { margin-top: 30px; container-type: inline-size; }
  .project-group h3 { margin: 0 0 8px; font-size: 1.18rem; }
  .project-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84%, 460px);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 4px;
    list-style: none;
    margin: 0;
    padding: 4px;
  }
  @container (min-width: 720px) {
    /* Leave the leading edge of the third card in view. */
    .project-row { grid-auto-columns: calc((100% - 112px) / 2); }
  }
  .project-row li { min-width: 0; scroll-snap-align: start; }
  .project-preview {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid #e2e6eb;
    border-radius: 10px;
  }
  .project-preview:hover { border-color: #a7b8cf; }
  .project-preview:focus-visible { outline-offset: 1px; }
  .project-preview img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: #f5f7fa;
    border-bottom: 1px solid #e2e6eb;
  }
  .project-preview img.cover-top { object-fit: cover; object-position: center top; }
  .preview-copy {
    display: grid;
    gap: 8px;
    padding: clamp(14px, 2vw, 20px);
    line-height: 1.4;
  }
  .preview-copy strong { font-size: 1.15rem; }
  .summary {
    color: #526070;
    font-size: 1rem;
    line-height: 1.55;
  }
</style>
