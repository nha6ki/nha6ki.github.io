---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSocialLinks from '../components/HomeSocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DevArticles from '../components/DevArticles.astro';
import { getCollection } from 'astro:content';

const featured = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout
  title="Haruki Niwa (丹羽開紀) | Research & Engineering"
  description="Haruki Niwa (丹羽開紀) works in research and engineering at Hiroshima University, specializing in machine learning, neuroscience, scientific computing, and research software."
>
  <section class="hero">
    <h1>Haruki Niwa</h1>

    <p class="lead">
        I work in research and engineering at Hiroshima University,
        focusing on machine learning, neuroscience, and scientific computing.
        My work includes developing research software, building computational
        infrastructure, and creating applications that make research outcomes
        accessible.
      </p>

    <HomeSocialLinks />
  </section>

  <section class="section" aria-labelledby="articles-heading">
    <div class="section-heading">
      <h2 id="articles-heading">Latest Articles</h2>
      <a class="text-link" href="/blog/">View all →</a>
    </div>

    <div class="home-articles">
      <DevArticles limit={6} />
    </div>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <h2 id="projects-heading">Selected Projects</h2>
      <a class="text-link" href="/projects/">View all →</a>
    </div>

    <div class="project-grid">
      {featured.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero h1 { margin-bottom: 6px; }



</style>
