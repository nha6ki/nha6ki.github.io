---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSocialLinks from '../components/HomeSocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DevArticles from '../components/DevArticles.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const pinnedIds = ['meowatlas', 'felisfield', 'lyrimelotrace', 'notable-musical-patterns', 'htcondor-gpu-pool', 'distributed-llm-inference-nvidia-dgx-spark'];
const pinned = pinnedIds.flatMap((id) =>
  featuredProjects.filter((project) => project.id === id)
);
const others = featuredProjects.filter((project) => !pinnedIds.includes(project.id));

const featured = [...others.slice(0, 2), ...pinned, ...others.slice(2, 4)];
---

<BaseLayout
  title="Haruki Niwa (丹羽開紀) | Research & Engineering"
  description="Haruki Niwa (丹羽開紀) works on neuroscience data analysis, machine learning, research software, and computing infrastructure at Hiroshima University, and builds interactive web applications as a hobby."
>
  <section class="hero">
    <h1>Haruki Niwa</h1>

    <p class="lead">
      At Hiroshima University, I work on neuroscience data analysis,
      machine learning models, research software, and computing infrastructure.
    </p>

    <p class="lead">
      Outside of work, I build interactive web applications as a hobby,
      exploring sound, music, and text through listening and visualization.
    </p>

    <HomeSocialLinks />
  </section>

  <section class="section" aria-labelledby="articles-heading">
    <div class="section-heading">
      <h2 id="articles-heading">Latest Articles</h2>
      <a class="text-link" href="/blog/">View all →</a>
    </div>

    <div class="home-articles">
      <DevArticles limit={6} />
    </div>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <h2 id="projects-heading">Selected Projects</h2>
      <a class="text-link" href="/projects/">View all →</a>
    </div>

    <div class="project-grid">
      {featured.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero h1 { margin-bottom: 6px; }



</style>
