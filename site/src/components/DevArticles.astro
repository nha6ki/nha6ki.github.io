---
interface Props {
  limit?: number;
  paginate?: boolean;
}

const { limit = 3, paginate = false } = Astro.props;
---

<div
  class="dev-articles"
  data-dev-articles
  data-page-size={limit}
  data-paginate={String(paginate)}
>
  {paginate && (
    <div
      class="article-categories"
      role="group"
      aria-label="Filter articles by category"
      hidden
    ></div>
  )}

  <p class="dev-status" role="status">Loading articles...</p>
  <div class="article-grid"></div>

  {paginate && (
    <button class="dev-load-more" type="button" hidden>
      Load more articles
    </button>
  )}

  <noscript>
    <p>
      JavaScript is required to display articles.
      <a href="https://dev.to/nha6ki">Read on DEV.to</a>.
    </p>
  </noscript>
</div>

<script>
  import { fetchArticles, validUrl, type Article } from '../lib/devto';
  const categories = [
    {
      id: 'ai',
      label: 'AI & Data Science',
      tags: ['machinelearning', 'deeplearning', 'ai', 'llm',
        'pytorch', 'tensorflow', 'datascience', 'ml', 'scikitlearn'],
    },
    {
      id: 'neuro',
      label: 'Neuroscience',
      tags: ['neuroscience', 'fmri', 'eeg',
        'neuroimaging', 'computationalneuroscience'],
    },
    {
      id: 'infra',
      label: 'Infrastructure & Cloud',
      tags: ['linux', 'docker', 'devops', 'cloud', 'hpc',
        'htcondor', 'gpu', 'gcp', 'kubernetes', 'grafana', 'prometheus'],
    },
    {
      id: 'robotics',
      label: 'Robotics',
      tags: ['ros', 'ros2', 'robotics', 'robot'],
    },
    {
      id: 'web',
      label: 'Web & Software',
      tags: ['webdev', 'astro', 'fastapi', 'javascript',
        'typescript', 'frontend', 'backend', 'api', 'html', 'css'],
    },
  ];

  function normalizeTag(tag: string): string {
    return tag.toLowerCase().replace(/[^a-z0-9]/g, '');
  }

  function getTags(article: Article): string[] {
    const source = Array.isArray(article.tag_list)
      ? article.tag_list
      : typeof article.tag_list === 'string'
        ? article.tag_list.split(',')
        : typeof article.tags === 'string'
          ? article.tags.split(',')
          : [];

    return source
      .filter((tag): tag is string => typeof tag === 'string')
      .map(normalizeTag);
  }

  function getCategoryId(article: Article): string {
    const tags = getTags(article);
    // Use one primary category. Specific topics take precedence over tools.
    const priority = ['robotics', 'neuro', 'ai', 'infra', 'web'];
    for (const id of priority) {
      const category = categories.find(item => item.id === id);
      if (category?.tags.some(tag => tags.includes(tag))) return id;
    }
    return 'other';
  }

  function getCategoryLabel(id: string): string {
    return categories.find(item => item.id === id)?.label ?? 'Other';
  }

  function matchesCategory(article: Article, id: string): boolean {
    return id === 'all' || getCategoryId(article) === id;
  }

  function makeCard(article: Article): HTMLAnchorElement {
    const categoryId = getCategoryId(article);
    const card = document.createElement('a');
    card.className = `article-card article-card--categorized article-card--category-${categoryId}`;
    card.href = article.url;
    card.target = '_blank';
    card.rel = 'noopener noreferrer';

    const imageBox = document.createElement('div');
    imageBox.className = 'article-image article-image--categorized';

    // Restore the old behavior: use a DEV.to cover, then its social image.
    // The social image is available for posts without a custom cover.
    const imageUrl = validUrl(article.cover_image) || validUrl(article.social_image);
    const showFallback = () => {
      imageBox.classList.add('article-image--missing');
      const label = document.createElement('span');
      label.className = 'article-image-topic';
      const topic = getTags(article)[0] || categoryId;
      label.textContent = topic.toUpperCase().slice(0, 18);
      imageBox.prepend(label);
    };

    if (imageUrl) {
      const img = document.createElement('img');
      img.src = imageUrl;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.addEventListener('error', () => {
        img.remove();
        showFallback();
      });
      imageBox.appendChild(img);
    } else {
      showFallback();
    }

    // A small category chip and card accent distinguish topics while
    // preserving each DEV.to image and the original card information.
    const category = document.createElement('span');
    category.className = 'article-cover-category';
    category.textContent = getCategoryLabel(categoryId);
    imageBox.appendChild(category);

    const content = document.createElement('div');
    content.className = 'article-content';
    const meta = document.createElement('div');
    meta.className = 'article-meta';

    if (article.published_at) {
      const date = new Date(article.published_at);
      if (!Number.isNaN(date.getTime())) {
        const time = document.createElement('time');
        time.dateTime = article.published_at;
        time.textContent = date.toLocaleDateString('en-US', {
          year: 'numeric', month: 'short', day: 'numeric',
        });
        meta.appendChild(time);
      }
    }

    if (typeof article.reading_time_minutes === 'number'
        && article.reading_time_minutes > 0) {
      const reading = document.createElement('span');
      reading.textContent = `${article.reading_time_minutes} min read`;
      meta.appendChild(reading);
    }

    const title = document.createElement('h3');
    title.className = 'article-card-title';
    title.textContent = article.title;
    content.append(meta, title);

    if (article.description) {
      const description = document.createElement('p');
      description.className = 'article-description';
      description.textContent = article.description;
      content.appendChild(description);
    }

    const tags = getTags(article);
    if (tags.length) {
      const tagRow = document.createElement('div');
      tagRow.className = 'article-tags';
      for (const tag of tags.slice(0, 3)) {
        const chip = document.createElement('span');
        chip.textContent = `#${tag}`;
        tagRow.appendChild(chip);
      }
      content.appendChild(tagRow);
    }

    card.append(imageBox, content);
    return card;
  }

  async function initialize(container: HTMLElement) {
    const pageSize = Math.max(
      1,
      Number(container.dataset.pageSize) || 3
    );

    const paginate = container.dataset.paginate === 'true';

    const grid = container.querySelector<HTMLElement>('.article-grid');
    const status = container.querySelector<HTMLElement>('.dev-status');
    const filters = container.querySelector<HTMLElement>('.article-categories');
    const loadMore = container.querySelector<HTMLButtonElement>('.dev-load-more');

    if (!grid || !status) return;

    try {
      const articles = await fetchArticles(paginate, pageSize);

      if (articles.length === 0) {
        status.className = 'dev-empty';
        status.textContent = 'No published articles yet.';
        return;
      }

      status.hidden = true;

      let selected = 'all';
      let visible = pageSize;

      function render() {
        const matching = articles.filter(article =>
          matchesCategory(article, selected)
        );

        grid!.replaceChildren(
          ...matching.slice(0, visible).map(makeCard)
        );

        if (loadMore) {
          loadMore.hidden = visible >= matching.length;
        }

        filters?.querySelectorAll<HTMLButtonElement>('button')
          .forEach(button => {
            button.setAttribute(
              'aria-pressed',
              String(button.dataset.category === selected)
            );
          });
      }

      if (paginate && filters) {
        const options = [
          { id: 'all', label: 'All' },
          ...categories.map(({ id, label }) => ({ id, label })),
          { id: 'other', label: 'Other' },
        ];

        for (const option of options) {
          const count = articles.filter(article =>
            matchesCategory(article, option.id)
          ).length;

          if (count === 0) continue;

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'category-button';
          button.dataset.category = option.id;
          button.textContent = `${option.label} (${count})`;

          button.addEventListener('click', () => {
            selected = option.id;
            visible = pageSize;
            render();
          });

          filters.appendChild(button);
        }

        filters.hidden = false;
      }

      loadMore?.addEventListener('click', () => {
        visible += pageSize;
        render();
      });

      render();
    } catch (error) {
      console.error('Failed to load DEV.to articles:', error);

      status.className = 'dev-empty';
      status.textContent =
        'Articles are temporarily unavailable. Please try again later.';
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-dev-articles]')
    .forEach(container => {
      void initialize(container);
    });
</script>
