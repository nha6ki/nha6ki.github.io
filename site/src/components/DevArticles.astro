---
interface Props {
  limit?: number;
  paginate?: boolean;
}

const { limit = 3, paginate = false } = Astro.props;
---

<div
  class="dev-articles"
  data-dev-articles
  data-page-size={limit}
  data-paginate={String(paginate)}
>
  {paginate && (
    <div
      class="article-categories"
      role="group"
      aria-label="Filter articles by category"
      hidden
    ></div>
  )}

  <p class="dev-status" role="status">Loading articles...</p>
  <div class="article-grid"></div>

  {paginate && (
    <button class="dev-load-more" type="button" hidden>
      Load more articles
    </button>
  )}

  <noscript>
    <p>
      JavaScript is required to display articles.
      <a href="https://dev.to/nha6ki">Read on DEV.to</a>.
    </p>
  </noscript>
</div>

<script>
  import { fetchArticles, validUrl, type Article } from '../lib/devto';

  // BLOG_CATEGORY_V3 — categories for the personal site's primary topics.
  const categories = [
    { id: 'ai', label: 'AI & Machine Learning',
      tags: ['llm', 'ollama', 'openwebui', 'gemma', 'machinelearning',
        'deeplearning', 'optuna', 'pytorch', 'tensorflow', 'datascience',
        'scikitlearn', 'ai', 'ml'] },
    { id: 'neuro', label: 'Neuroscience',
      tags: ['neuroscience', 'neuroimaging', 'fmri', 'eeg', 'fsl', 'ants',
        'fmriprep', 'nifti', 'bids', 'computationalneuroscience'] },
    { id: 'infra', label: 'Systems & Infrastructure',
      tags: ['htcondor', 'hpc', 'networking', 'nas', 'raid', 'devops',
        'kubernetes', 'gcp', 'grafana', 'prometheus', 'cloud', 'dualboot'] },
    { id: 'data', label: 'Data Engineering & Automation',
      tags: ['automation', 'dataengineering', 'etl', 'datapipeline',
        'webscraping', 'datamigration', 'database', 'scrapy', 'rclone'] },
    { id: 'robotics', label: 'Robotics',
      tags: ['robotics', 'ros', 'ros2', 'robot'] },
    { id: 'web', label: 'Web & Applications',
      tags: ['webdev', 'astro', 'fastapi', 'javascript', 'typescript',
        'frontend', 'backend', 'html', 'css', 'webapp', 'softwaretesting'] },
  ];
  // Prefer these explicit assignments for published, cross-disciplinary posts.
  const explicitCategories: Record<string, string> = {
    'running-ollama-on-amd-ryzen-ai-max-395-with-rocm-and-docker-1a3g': 'ai',
    'configuring-gemma-4-31b-and-open-webui-for-a-research-laboratory-183d': 'ai',
    'troubleshooting-ollama-gpu-inference-failures-on-amd-ryzen-ai-max-2gp': 'ai',
    'tracking-optuna-experiments-with-journalstorage-and-optuna-dashboard-3b7b': 'ai',
    'installing-fsl-and-fix-on-linux-legacy-rmatlab-setup-and-modern-python-fix-381j': 'neuro',
    'benchmarking-10gbe-nas-to-nas-transfers-iperf-nfs-cp-and-rsync-4p1j': 'infra',
    'writing-htcondor-dag-files-job-dependencies-variables-and-concurrency-limits-15ng': 'infra',
    'dual-booting-windows-and-ubuntu-a-step-by-step-uefi-installation-guide-h0l': 'infra',
    'automating-google-calendar-screenshots-with-playwright-rclone-and-systemd-4j6l': 'data',
    'running-ros-1-gui-applications-on-macos-with-docker-and-xquartz-3931': 'robotics',
  };
  // Paths are fixed UI icons, not data from DEV.to.
  const categoryIcons: Record<string, string> = {
    all: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
    ai: '<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M8 6h8M7 8l4 8m6-8-4 8"/>',
    neuro: '<path d="M2 12h5l3-7 4 14 3-7h5"/>',
    infra: '<rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 7h.01M7 18h.01M11 7h7M11 18h7"/>',
    data: '<rect x="2" y="3" width="7" height="7" rx="1"/><rect x="15" y="14" width="7" height="7" rx="1"/><path d="M9 6h5a4 4 0 0 1 4 4v4M6 10v5a4 4 0 0 0 4 4h5"/>',
    robotics: '<rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 8V4m-3 0h6M8 13h.01M16 13h.01M9 17h6"/>',
    web: '<path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 20"/>',
    other: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a3 3 0 1 1 5 2c-1.5 1-2.5 2-2.5 3m0 3h.01"/>',
  };
  function makeCategoryIcon(id: string): SVGSVGElement {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '1.8');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    svg.innerHTML = categoryIcons[id] ?? categoryIcons.other;
    return svg;
  }

  function normalizeTag(tag: string): string {
    return tag.toLowerCase().replace(/[^a-z0-9]/g, '');
  }

  function getTags(article: Article): string[] {
    const source = Array.isArray(article.tag_list)
      ? article.tag_list
      : typeof article.tag_list === 'string'
        ? article.tag_list.split(',')
        : typeof article.tags === 'string'
          ? article.tags.split(',')
          : [];

    return source
      .filter((tag): tag is string => typeof tag === 'string')
      .map(normalizeTag);
  }

  function getCategoryId(article: Article): string {
    let slug = '';
    try {
      slug = new URL(article.url).pathname.split('/').filter(Boolean).pop() ?? '';
    } catch {
      // A malformed article URL should not prevent the Blog from rendering.
    }
    if (Object.prototype.hasOwnProperty.call(explicitCategories, slug)) {
      return explicitCategories[slug];
    }
    const tags = new Set(getTags(article));
    // Specific topic tags matter more than general-purpose tools or OS tags.
    for (const id of ['robotics', 'neuro', 'ai', 'data', 'infra', 'web']) {
      const category = categories.find(item => item.id === id);
      if (category?.tags.some(tag => tags.has(tag))) return id;
    }
    return 'other';
  }

  function getCategoryLabel(id: string): string {
    return categories.find(item => item.id === id)?.label ?? 'Other';
  }

  function matchesCategory(article: Article, id: string): boolean {
    return id === 'all' || getCategoryId(article) === id;
  }

  function makeCard(article: Article): HTMLAnchorElement {
    const categoryId = getCategoryId(article);
    const card = document.createElement('a');
    card.className = `article-card article-card--categorized article-card--category-${categoryId}`;
    card.href = article.url;
    card.target = '_blank';
    card.rel = 'noopener noreferrer';

    const imageBox = document.createElement('div');
    imageBox.className = 'article-image article-image--categorized';

    // Restore the old behavior: use a DEV.to cover, then its social image.
    // The social image is available for posts without a custom cover.
    const imageUrl = validUrl(article.cover_image) || validUrl(article.social_image);
    const showFallback = () => {
      imageBox.classList.add('article-image--missing');
      const label = document.createElement('span');
      label.className = 'article-image-topic';
      const topic = getTags(article)[0] || categoryId;
      label.textContent = topic.toUpperCase().slice(0, 18);
      imageBox.prepend(label);
    };

    if (imageUrl) {
      const img = document.createElement('img');
      img.src = imageUrl;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.addEventListener('error', () => {
        img.remove();
        showFallback();
      });
      imageBox.appendChild(img);
    } else {
      showFallback();
    }

    const content = document.createElement('div');
    content.className = 'article-content';
    const meta = document.createElement('div');
    meta.className = 'article-meta';

    if (article.published_at) {
      const date = new Date(article.published_at);
      if (!Number.isNaN(date.getTime())) {
        const time = document.createElement('time');
        time.dateTime = article.published_at;
        time.textContent = date.toLocaleDateString('en-US', {
          year: 'numeric', month: 'short', day: 'numeric',
        });
        meta.appendChild(time);
      }
    }

    if (typeof article.reading_time_minutes === 'number'
        && article.reading_time_minutes > 0) {
      const reading = document.createElement('span');
      reading.textContent = `${article.reading_time_minutes} min read`;
      meta.appendChild(reading);
    }

    const title = document.createElement('h3');
    title.className = 'article-card-title';
    title.textContent = article.title;
    const category = document.createElement('span');
    category.className = 'article-category-badge';
    category.append(makeCategoryIcon(categoryId), document.createTextNode(getCategoryLabel(categoryId)));
    content.append(category, meta, title);

    if (article.description) {
      const description = document.createElement('p');
      description.className = 'article-description';
      description.textContent = article.description;
      content.appendChild(description);
    }

    const tags = getTags(article);
    if (tags.length) {
      const tagRow = document.createElement('div');
      tagRow.className = 'article-tags';
      for (const tag of tags.slice(0, 3)) {
        const chip = document.createElement('span');
        chip.textContent = `#${tag}`;
        tagRow.appendChild(chip);
      }
      content.appendChild(tagRow);
    }

    card.append(imageBox, content);
    return card;
  }

  async function initialize(container: HTMLElement) {
    const pageSize = Math.max(
      1,
      Number(container.dataset.pageSize) || 3
    );

    const paginate = container.dataset.paginate === 'true';

    const grid = container.querySelector<HTMLElement>('.article-grid');
    const status = container.querySelector<HTMLElement>('.dev-status');
    const filters = container.querySelector<HTMLElement>('.article-categories');
    const loadMore = container.querySelector<HTMLButtonElement>('.dev-load-more');

    if (!grid || !status) return;

    try {
      const articles = await fetchArticles(paginate, pageSize);

      if (articles.length === 0) {
        status.className = 'dev-empty';
        status.textContent = 'No published articles yet.';
        return;
      }

      status.hidden = true;

      let selected = 'all';
      let visible = pageSize;

      function render() {
        const matching = articles.filter(article =>
          matchesCategory(article, selected)
        );

        grid!.replaceChildren(
          ...matching.slice(0, visible).map(makeCard)
        );

        if (loadMore) {
          loadMore.hidden = visible >= matching.length;
        }

        filters?.querySelectorAll<HTMLButtonElement>('button')
          .forEach(button => {
            button.setAttribute(
              'aria-pressed',
              String(button.dataset.category === selected)
            );
          });
      }

      if (paginate && filters) {
        const options = [
          { id: 'all', label: 'All' },
          ...categories.map(({ id, label }) => ({ id, label })),
          { id: 'other', label: 'Other' },
        ];

        for (const option of options) {
          const count = articles.filter(article =>
            matchesCategory(article, option.id)
          ).length;

          if (count === 0) continue;

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'category-button';
          button.dataset.category = option.id;
          button.append(makeCategoryIcon(option.id), `${option.label} (${count})`);

          button.addEventListener('click', () => {
            selected = option.id;
            visible = pageSize;
            render();
          });

          filters.appendChild(button);
        }

        filters.hidden = false;
      }

      loadMore?.addEventListener('click', () => {
        visible += pageSize;
        render();
      });

      render();
    } catch (error) {
      console.error('Failed to load DEV.to articles:', error);

      status.className = 'dev-empty';
      status.textContent =
        'Articles are temporarily unavailable. Please try again later.';
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-dev-articles]')
    .forEach(container => {
      void initialize(container);
    });
</script>
