---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<a class="project-card" href={`/projects/${project.id}/`}>
  <div
    class:list={[
      'project-card-media',
      { 'project-card-media-empty': !project.data.image },
    ]}
  >
    {project.data.image ? (
      <img
        src={project.data.image}
        alt={project.data.imageAlt ?? `Preview of ${project.data.title}`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span aria-hidden="true">PROJECT</span>
    )}
  </div>

  <div class="project-card-content">
    <span class="project-title">
      {project.data.title}
    </span>

    <p class="project-summary">
      {project.data.summary}
    </p>

    <div class="technologies">
      {project.data.technologies.join(' · ')}
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e6eb;
    border-radius: 10px;
    transition: border-color 180ms ease,
                box-shadow 180ms ease,
                transform 180ms ease;
  }

  .project-card:hover {
    border-color: #a7b8cf;
    box-shadow: 0 6px 18px rgb(20 40 60 / 6%);
    transform: translateY(-2px);
  }

  .project-card-media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid #e2e6eb;
    background: #f5f7fa;
  }

  .project-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-card-media-empty {
    background: #f1f4f8;
    color: #8994a3;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .12em;
  }

  .project-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
  }

  .project-title {
    display: block;
    font-size: 1.08rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .project-summary {
    margin: 0;
    color: #606a79;
    line-height: 1.65;
  }

  .technologies {
    margin-top: auto;
    padding-top: 10px;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .project-card-content {
      padding: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
</style>
